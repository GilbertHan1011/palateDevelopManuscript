   "source": [
    "snpscore_full = pd.read_csv(\"../process/framework/snps/20250219_SNPs_annoated_peaks_scenic_extended_full.csv\",index_col=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "be79b60c-94a0-4100-a15f-b584ed46c1c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "snp_name_dict = {k: v for k, v in zip(gene_snp[\"symbol\"], gene_snp['snp_rsid'])}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "c23e94ab-e467-4ce6-8889-1166df885e82",
   "metadata": {},
   "outputs": [],
   "source": [
    "peak = snpscore[\"seqnames\"] + \":\" + snpscore[\"start\"].astype(str) + \"-\" + snpscore[\"end\"].astype(str)\n",
    "peak_snp_name_dict =  {k: v for k, v in zip(peak, snpscore_full['overlapping_snps_extend'])}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "45625289-f1f0-4530-b2ef-4f8df3817a3f",
   "metadata": {},
   "outputs": [],
   "source": [
    "peak_snp_name_dict.update(snp_name_dict)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "ec73420c-efa2-4403-878c-87b955d40985",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "WARNING: adata.X seems to be already log-transformed.\n"
     ]
    }
   ],
   "source": [
    "ad = sc.read(\"../process/framework/obj/rna_raw_scglue_prepare.h5ad\")\n",
    "ad.X = ad.layers[\"counts\"].copy()\n",
    "\n",
    "sc.pp.normalize_total(ad)\n",
    "sc.pp.log1p(ad)\n",
    "ad.raw = ad"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "781c6189-7129-475b-95ad-5550b34d6891",
   "metadata": {},
   "outputs": [],
   "source": [
    "label = pd.read_csv(\"../../2024.4_scATAC/processed_data/cluster/rna_annotation_scvi_mod.csv\",index_col=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
