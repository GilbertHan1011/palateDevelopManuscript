  {
   "cell_type": "code",
   "execution_count": 61,
   "id": "5510cbeb-3565-42cb-b0ed-25376e6142c5",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def export_networkx_to_csv(G, nodes_path=\"nodes.csv\", edges_path=\"edges.csv\"):\n",
    "    \"\"\"\n",
    "    Export a NetworkX graph to CSV files\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    G : NetworkX graph\n",
    "        The graph to export\n",
    "    nodes_path : str\n",
    "        Path to save nodes CSV file\n",
    "    edges_path : str\n",
    "        Path to save edges CSV file\n",
    "    \"\"\"\n",
    "    # 1. Export nodes with their attributes\n",
    "    nodes_df = pd.DataFrame.from_dict(dict(G.nodes(data=True)), orient='index')\n",
    "    nodes_df.index.name = 'node'\n",
    "    nodes_df.reset_index(inplace=True)\n",
    "    nodes_df.to_csv(nodes_path, index=False)\n",
    "    \n",
    "    # 2. Export edges with their attributes\n",
    "    edges = []\n",
    "    for u, v, data in G.edges(data=True):\n",
    "        edge_data = {'source': u, 'target': v}\n",
    "        edge_data.update(data)\n",
    "        edges.append(edge_data)\n",
    "    \n",
    "    edges_df = pd.DataFrame(edges)\n",
    "    edges_df.to_csv(edges_path, index=False)\n",
    "    \n",
    "    print(f\"Exported {len(nodes_df)} nodes to {nodes_path}\")\n",
    "    print(f\"Exported {len(edges_df)} edges to {edges_path}\")\n"
   ]
  },
