     "data": {
      "text/plain": [
       "'\\n# Optional: Filter to specific nodes\\nfiltered_graph, fig = create_beautiful_network_plot(\\n    G, \\n    nodes_to_keep=SELECTED_NODES2, \\n    title=\"Selected GRN\",\\n    export_pdf=\"../result/SNP/20250213_snp2cell_round1/network_graph.pdf\"\\n)\\n\\n# Display the plot\\nfig.show()\\n\\n# Also save to HTML for interactive viewing\\nfig.write_html(\"../result/SNP/20250213_snp2cell_round1/beautiful_network.html\")\\n'"
      ]
     },
     "execution_count": 58,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import networkx as nx\n",
    "import plotly.graph_objects as go\n",
    "import numpy as np\n",
    "import plotly.io as pio\n",
    "\n",
    "def create_beautiful_network_plot(G, nodes_to_keep=None, title=\"Network Graph\", export_pdf=None):\n",
    "    \"\"\"\n",
    "    Create a beautiful network plot with custom node shapes based on node names.\n",
    "    - Nodes starting with \"chr\" are triangles\n",
    "    - Other nodes are circles\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    G : NetworkX graph\n",
    "        The original graph\n",
    "    nodes_to_keep : list, optional\n",
    "        List of node names/IDs to keep (if None, uses all nodes)\n",
    "    title : str\n",
    "        Title for the plot\n",
    "    export_pdf : str, optional\n",
    "        Filepath to export PDF (if None, no PDF is exported)\n",
    "        \n",
    "    Returns:\n",
    "    --------\n",
    "    filtered_graph : NetworkX graph\n",
    "        The filtered subgraph (or original if no filtering)\n",
    "    fig : Plotly figure\n",
    "        The plotly figure object with the plot\n",
    "    \"\"\"\n",
    "    # Filter nodes if specified\n",
    "    if nodes_to_keep is not None:\n",
    "        valid_nodes = [node for node in nodes_to_keep if node in G.nodes()]\n",
    "        graph = G.subgraph(valid_nodes).copy()\n",
    "    else:\n",
    "        graph = G.copy()\n",
    "    \n",
    "    # Generate layout\n",
    "    pos = nx.kamada_kawai_layout(graph)\n",
    "    \n",
    "    # Create edge traces with curved edges\n",
    "    edge_traces = []\n",
    "    \n",
    "    # Define a pleasing color palette\n",
    "    edge_colors = ['#a6cee3', '#1f78b4', '#b2df8a', '#33a02c']\n",
    "    \n",
    "    for i, edge in enumerate(graph.edges()):\n",
    "        # Calculate curve parameters\n",
    "        x0, y0 = pos[edge[0]]\n",
    "        x1, y1 = pos[edge[1]]\n",
    "        \n",
    "        # Create a slight curve for visual appeal\n",
    "        # Use more points for smoother curves\n",
    "        num_points = 20\n",
    "        \n",
    "        # Determine if we need a curved edge (self-loops or to avoid overlap)\n",
    "        if edge[0] == edge[1]:  # Self-loop\n",
    "            # Create a loop\n",
    "            radius = 0.05\n",
    "            center_x = x0\n",
    "            center_y = y0 + radius\n",
    "            \n",
    "            # Create a circle\n",
    "            theta = np.linspace(0, 2*np.pi, num_points)\n",
    "            edge_x = center_x + radius * np.cos(theta)\n",
    "            edge_y = center_y + radius * np.sin(theta)\n",
    "            \n",
    "        else:\n",
    "            # Create a quadratic Bezier curve\n",
    "            # Control point is perpendicular to the middle of the line\n",
    "            mid_x = (x0 + x1) / 2\n",
    "            mid_y = (y0 + y1) / 2\n",
    "            \n",
    "            # Vector perpendicular to the line\n",
    "            dx = x1 - x0\n",
    "            dy = y1 - y0\n",
    "            length = np.sqrt(dx**2 + dy**2)\n",
    "            \n",
    "            # Normalize and rotate 90 degrees\n",
    "            # Curve intensity depends on graph density\n",
    "            curve_intensity = 0.1 * min(1.0, 10.0/len(graph.edges()))\n",
    "            nx_ = -dy / length * curve_intensity  # Renamed to avoid conflict with the module\n",
    "            ny = dx / length * curve_intensity\n",
    "            \n",
    "            # Control point\n",
    "            ctrl_x = mid_x + nx_\n",
    "            ctrl_y = mid_y + ny\n",
    "            \n",
    "            # Create the curve using parametric equation of quadratic Bezier\n",
    "            t = np.linspace(0, 1, num_points)\n",
    "            edge_x = (1-t)**2 * x0 + 2*(1-t)*t * ctrl_x + t**2 * x1\n",
    "            edge_y = (1-t)**2 * y0 + 2*(1-t)*t * ctrl_y + t**2 * y1\n",
    "        \n",
    "        # Add None to create breaks in the line\n",
    "        edge_x = list(edge_x)\n",
    "        edge_y = list(edge_y)\n",
    "        \n",
    "        # Select color from palette\n",
    "        color = edge_colors[i % len(edge_colors)]\n",
    "        \n",
    "        edge_trace = go.Scatter(\n",
    "            x=edge_x, y=edge_y,\n",
    "            line=dict(width=15, color=color, shape='spline'),  # INCREASED line width\n",
    "            hoverinfo='none',\n",
    "            mode='lines',\n",
    "            opacity=0.8  # Slightly increased opacity\n",
    "        )\n",
    "        \n",
    "        edge_traces.append(edge_trace)\n",
    "    \n",
    "    # Separate nodes into two categories based on name\n",
    "    chr_nodes = []\n",
    "    other_nodes = []\n",
    "    \n",
    "    for node in graph.nodes():\n",
    "        node_str = str(node)\n",
    "        if node_str.startswith('chr'):\n",
    "            chr_nodes.append(node)\n",
    "        else:\n",
    "            other_nodes.append(node)\n",
    "    \n",
    "    # Create node traces for chromosome nodes (triangles)\n",
    "    chr_node_x = [pos[node][0] for node in chr_nodes]\n",
    "    chr_node_y = [pos[node][1] for node in chr_nodes]\n",
    "    chr_node_text = [str(node) for node in chr_nodes]\n",
    "    \n",
    "    chr_node_trace = go.Scatter(\n",
    "        x=chr_node_x, y=chr_node_y,\n",
    "        mode='markers+text',\n",
    "        hoverinfo='text',\n",
    "        text=chr_node_text,\n",
    "        textposition=\"top center\",\n",
    "        marker=dict(\n",
    "            symbol='triangle-up',\n",
    "            size=30,  # INCREASED node size\n",
    "            color='#ff7f0e',  # Distinct color for chromosome nodes\n",
    "            line=dict(width=15, color='#555555'),  # INCREASED outline width\n",
    "        ),\n",
    "        textfont=dict(\n",
    "            size=25,  # INCREASED font size\n",
    "            color='#333333',\n",
    "            family=\"Arial, sans-serif\", \n",
    "        ),\n",
    "        name='Chromosome Positions'\n",
    "    )\n",
    "    \n",
    "    # Create node traces for other nodes (circles)\n",
    "    other_node_x = [pos[node][0] for node in other_nodes]\n",
    "    other_node_y = [pos[node][1] for node in other_nodes]\n",
    "    other_node_text = [str(node) for node in other_nodes]\n",
    "    \n",
    "    other_node_trace = go.Scatter(\n",
    "        x=other_node_x, y=other_node_y,\n",
    "        mode='markers+text',\n",
    "        hoverinfo='text',\n",
    "        text=other_node_text,\n",
    "        textposition=\"top center\",\n",
    "        marker=dict(\n",
    "            symbol='circle',\n",
    "            size=18,  # INCREASED node size\n",
    "            color='#1f77b4',  # Blue color for other nodes\n",
    "            line=dict(width=15, color='#555555'),  # INCREASED outline width\n",
    "        ),\n",
    "        textfont=dict(\n",
    "            size=25,  # INCREASED font size\n",
    "            color='#333333',\n",
    "            family=\"Arial, sans-serif\",\n",
    "        ),\n",
    "        name='Genes/Other'\n",
    "    )\n",
    "    \n",
    "    # Create figure with a pleasing background\n",
    "    data = edge_traces + [chr_node_trace, other_node_trace]\n",
    "    \n",
    "    fig = go.Figure(\n",
    "        data=data,\n",
    "        layout=go.Layout(\n",
    "            title=dict(\n",
    "                text=title,\n",
    "                font=dict(family=\"Arial, sans-serif\", size=24, color=\"#333333\"),  # INCREASED title size\n",
    "                x=0.5,  # Center title\n",
    "            ),\n",
    "            showlegend=True,\n",
    "            legend=dict(\n",
    "                x=1.05,\n",
    "                y=0.5,\n",
    "                orientation='v',\n",
    "                bgcolor='rgba(255,255,255,0.8)',\n",
    "                bordercolor='#dddddd',\n",
    "                borderwidth=1,\n",
    "                font=dict(size=14)  # INCREASED legend text size\n",
    "            ),\n",
    "            hovermode='closest',\n",
    "            margin=dict(b=40, l=20, r=20, t=60),  # Increased margins\n",
    "            xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
    "            yaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
    "            plot_bgcolor='#f8f9fa',  # Light background color\n",
    "            paper_bgcolor='#ffffff',\n",
    "            font=dict(family=\"Arial, sans-serif\"),\n",
    "            autosize=True,\n",
    "            width=1200,  # INCREASED width\n",
    "            height=900,   # INCREASED height\n",
    "        )\n",
    "    )\n",
    "    \n",
    "    # Export to PDF if requested\n",
    "    if export_pdf:\n",
    "        # Make sure kaleido is installed: pip install kaleido\n",
    "        try:\n",
    "            fig.write_image(export_pdf, scale=2)  # Higher scale for better quality\n",
    "            print(f\"PDF exported successfully to {export_pdf}\")\n",
    "        except Exception as e:\n",
    "            print(f\"Error exporting PDF: {e}\")\n",
    "            print(\"Make sure you have installed kaleido: pip install kaleido\")\n",
    "    \n",
    "    return graph, fig\n",
    "\n",
    "# Example usage:\n",
    "\"\"\"\n",
    "# Optional: Filter to specific nodes\n",
    "filtered_graph, fig = create_beautiful_network_plot(\n",
    "    G, \n",
    "    nodes_to_keep=SELECTED_NODES2, \n",
    "    title=\"Selected GRN\",\n",
    "    export_pdf=\"../result/SNP/20250213_snp2cell_round1/network_graph.pdf\"\n",
    ")\n",
    "\n",
    "# Display the plot\n",
    "fig.show()\n",
    "\n",
    "# Also save to HTML for interactive viewing\n",
    "fig.write_html(\"../result/SNP/20250213_snp2cell_round1/beautiful_network.html\")\n",
    "\"\"\""
   ]
  },
