{
 "cells": [
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "821db6d6-ea01-42c8-8cb8-fb1dd7a4069d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import snp2cell\n",
    "import networkx as nx\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import scanpy as sc\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "8c9fecf4-d0e7-4719-8ae3-008f96946dc1",
   "metadata": {},
   "outputs": [],
   "source": [
    "csvFile = pd.read_csv(\"../process/SNP/SNP2ell/20250226_network_table_1000_full.csv\",index_col=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "26fb9804-f969-48c6-b740-e8dbcf807145",
   "metadata": {},
   "outputs": [],
   "source": [
    "G = nx.from_pandas_edgelist(\n",
    "        csvFile,\n",
    "        source='TF',  # source column name\n",
    "        target='gene',  # target column name\n",
    "        edge_attr='width'  # weight column name (optional)\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "ddff40cc-eedc-4afd-85ad-269c22ebd2e5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "nx.draw_kamada_kawai(G, with_labels=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "f83424ed-66b8-46b0-bff3-286fc77910a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "s2c = snp2cell.SNP2CELL()\n",
    "s2c.add_grn_from_networkx(G)\n",
    "snpscore = pd.read_csv(\"../process/framework/snps/20250219_SNPs_annoated_peaks_scenic_extended.csv\",index_col=0)\n",
    "peak = snpscore[\"seqnames\"] + \":\" + snpscore[\"start\"].astype(str) + \"-\" + snpscore[\"end\"].astype(str)\n",
    "peak_snp_dict =  {k: v for k, v in zip(peak, snpscore['has_snp'])}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "d29762d4-f09e-4b7b-be85-9214e032eda6",
   "metadata": {},
   "outputs": [],
   "source": [
    "gene_snp = pd.read_csv(\"../process/SNP/SNP2ell/20250219_prepare_gene_snp_extend500.csv\",index_col=0)\n",
    "gene_snp_dict ={k: v for k, v in zip(gene_snp[\"symbol\"], gene_snp['has_snp'])}\n",
    "peak_snp_dict.update(gene_snp_dict)"
   ]
  },
