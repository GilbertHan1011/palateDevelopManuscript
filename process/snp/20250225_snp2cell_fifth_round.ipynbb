  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "0db4843d-6190-48e2-9227-19f6eaa4626d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "'\\n# Define nodes you want to keep\\nnodes_to_keep = [\\'gene1\\', \\'gene2\\', \\'gene3\\', \\'gene4\\', \\'gene5\\']\\n\\n# Filter and plot\\nfiltered_graph, fig = filter_and_plot_network(G, nodes_to_keep, \\n                                             title=\"My Filtered Gene Network\")\\n\\n# Display the plot\\nfig.show()\\n\\n# Save the figure\\nfig.write_html(\"filtered_network.html\")\\n'"
      ]
     },
     "execution_count": 33,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import networkx as nx\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "def filter_and_plot_network(G, nodes_to_keep, title=\"Filtered Network\", maintain_original_positions=True):\n",
    "    \"\"\"\n",
    "    Filter a NetworkX graph to keep only specified nodes and plot it.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    G : NetworkX graph\n",
    "        The original graph\n",
    "    nodes_to_keep : list\n",
    "        List of node names/IDs to keep in the filtered graph\n",
    "    title : str\n",
    "        Title for the plot\n",
    "    maintain_original_positions : bool\n",
    "        If True, will use the original graph's layout for positioning\n",
    "    \n",
    "    Returns:\n",
    "    --------\n",
    "    filtered_graph : NetworkX graph\n",
    "        The filtered subgraph\n",
    "    fig : Plotly figure\n",
    "        The plotly figure object with the plot\n",
    "    \"\"\"\n",
    "    # Ensure all nodes exist in the graph\n",
    "    valid_nodes = [node for node in nodes_to_keep if node in G.nodes()]\n",
    "    \n",
    "    if len(valid_nodes) != len(nodes_to_keep):\n",
    "        print(f\"Warning: {len(nodes_to_keep) - len(valid_nodes)} nodes not found in the graph\")\n",
    "    \n",
    "    # Create subgraph with only the specified nodes\n",
    "    subgraph = G.subgraph(valid_nodes).copy()\n",
    "    \n",
    "    # Generate layout positions\n",
    "    if maintain_original_positions:\n",
    "        # First get positions for all nodes in the original graph\n",
    "        full_pos = nx.kamada_kawai_layout(G)\n",
    "        # Then extract positions only for our filtered nodes\n",
    "        pos = {node: full_pos[node] for node in subgraph.nodes()}\n",
    "    else:\n",
    "        # Generate new layout just for the subgraph\n",
    "        pos = nx.kamada_kawai_layout(subgraph)\n",
    "    \n",
    "    # Create edge traces\n",
    "    edge_x = []\n",
    "    edge_y = []\n",
    "    for edge in subgraph.edges():\n",
    "        x0, y0 = pos[edge[0]]\n",
    "        x1, y1 = pos[edge[1]]\n",
    "        edge_x.extend([x0, x1, None])\n",
    "        edge_y.extend([y0, y1, None])\n",
    "    \n",
    "    edge_trace = go.Scatter(\n",
    "        x=edge_x, y=edge_y,\n",
    "        line=dict(width=0.5, color='#888'),\n",
    "        hoverinfo='none',\n",
    "        mode='lines'\n",
    "    )\n",
    "    \n",
    "    # Create node traces\n",
    "    node_x = []\n",
    "    node_y = []\n",
    "    node_text = []\n",
    "    for node in subgraph.nodes():\n",
    "        x, y = pos[node]\n",
    "        node_x.append(x)\n",
    "        node_y.append(y)\n",
    "        node_text.append(str(node))\n",
    "    \n",
    "    node_trace = go.Scatter(\n",
    "        x=node_x, y=node_y,\n",
    "        mode='markers+text',\n",
    "        hoverinfo='text',\n",
    "        text=node_text,\n",
    "        textposition=\"top center\",\n",
    "        marker=dict(\n",
    "            size=10,\n",
    "            color='#1f77b4',\n",
    "        ),\n",
    "        textfont=dict(\n",
    "            size=8\n",
    "        )\n",
    "    )\n",
    "    \n",
    "    # Create figure\n",
    "    fig = go.Figure(data=[edge_trace, node_trace],\n",
    "                   layout=go.Layout(\n",
    "                       title=title,\n",
    "                       showlegend=False,\n",
    "                       hovermode='closest',\n",
    "                       margin=dict(b=20,l=5,r=5,t=40),\n",
    "                       xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
    "                       yaxis=dict(showgrid=False, zeroline=False, showticklabels=False)\n",
    "                   ))\n",
    "    \n",
    "    return subgraph, fig\n",
    "\n",
    "# Example usage:\n",
    "\"\"\"\n",
    "# Define nodes you want to keep\n",
    "nodes_to_keep = ['gene1', 'gene2', 'gene3', 'gene4', 'gene5']\n",
    "\n",
    "# Filter and plot\n",
    "filtered_graph, fig = filter_and_plot_network(G, nodes_to_keep, \n",
    "                                             title=\"My Filtered Gene Network\")\n",
    "\n",
    "# Display the plot\n",
    "fig.show()\n",
    "\n",
    "# Save the figure\n",
    "fig.write_html(\"filtered_network.html\")\n",
    "\"\"\""
   ]
  },
