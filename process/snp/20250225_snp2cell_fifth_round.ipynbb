0.323151955024889,0.3390798299137586,0.35587353240730246,0.37353306250552065,0.3920584202084131,0.41144960551597975,0.43170661842822067,0.4528294589451358,0.4748181270667254],\"type\":\"scatter\"},{\"hoverinfo\":\"text\",\"marker\":{\"color\":\"#ff7f0e\",\"line\":{\"color\":\"#555555\",\"width\":1},\"size\":15,\"symbol\":\"triangle-up\"},\"mode\":\"markers+text\",\"name\":\"Chromosome Positions\",\"text\":[\"chr2:25172559-25173059\",\"chr15:100639929-100640429\",\"chr6:142748842-142749342\"],\"textfont\":{\"color\":\"#555555\",\"size\":10},\"textposition\":\"top center\",\"x\":[0.2184044886653653,-0.5901838484731904,0.02385182713552704],\"y\":[-0.22527043602706232,0.0327433156556347,0.4748181270667254],\"type\":\"scatter\"},{\"hoverinfo\":\"text\",\"marker\":{\"color\":\"#1f77b4\",\"line\":{\"color\":\"#555555\",\"width\":1},\"size\":12,\"symbol\":\"circle\"},\"mode\":\"markers+text\",\"name\":\"Genes\\u002fOther\",\"text\":[\"Nrarp\",\"Grhl1\",\"Cmas\",\"Smagp\",\"Nfe2l2\",\"Grhl3\",\"Junb\"],\"textfont\":{\"color\":\"#555555\",\"size\":10},\"textposition\":\"top center\",\"x\":[0.6749991727028312,-0.15304396826019953,0.04021150737609493,-1.0,-0.005569206507122681,0.3616111547715413,0.42971887258915303],\"y\":[-0.23184578573153455,0.060157083476074465,0.8959652978029886,0.014437235153803431,-0.614884974723349,0.20508995315582487,-0.6112098158291056],\"type\":\"scatter\"}],                        {\"autosize\":true,\"font\":{\"family\":\"Open Sans, sans-serif\"},\"height\":700,\"hovermode\":\"closest\",\"legend\":{\"bgcolor\":\"rgba(255,255,255,0.8)\",\"bordercolor\":\"#dddddd\",\"borderwidth\":1,\"orientation\":\"v\",\"x\":1.05,\"y\":0.5},\"margin\":{\"b\":20,\"l\":5,\"r\":5,\"t\":40},\"paper_bgcolor\":\"#ffffff\",\"plot_bgcolor\":\"#f8f9fa\",\"showlegend\":true,\"title\":{\"font\":{\"color\":\"#333333\",\"family\":\"Open Sans, sans-serif\",\"size\":16},\"text\":\"Selected GRN\",\"x\":0.5},\"width\":900,\"xaxis\":{\"showgrid\":false,\"showticklabels\":false,\"zeroline\":false},\"yaxis\":{\"showgrid\":false,\"showticklabels\":false,\"zeroline\":false},\"template\":{\"data\":{\"histogram2dcontour\":[{\"type\":\"histogram2dcontour\",\"colorbar\":{\"outlinewidth\":0,\"ticks\":\"\"},\"colorscale\":[[0.0,\"#0d0887\"],[0.1111111111111111,\"#46039f\"],[0.2222222222222222,\"#7201a8\"],[0.3333333333333333,\"#9c179e\"],[0.4444444444444444,\"#bd3786\"],[0.5555555555555556,\"#d8576b\"],[0.6666666666666666,\"#ed7953\"],[0.7777777777777778,\"#fb9f3a\"],[0.8888888888888888,\"#fdca26\"],[1.0,\"#f0f921\"]]}],\"choropleth\":[{\"type\":\"choropleth\",\"colorbar\":{\"outlinewidth\":0,\"ticks\":\"\"}}],\"histogram2d\":[{\"type\":\"histogram2d\",\"colorbar\":{\"outlinewidth\":0,\"ticks\":\"\"},\"colorscale\":[[0.0,\"#0d0887\"],[0.1111111111111111,\"#46039f\"],[0.2222222222222222,\"#7201a8\"],[0.3333333333333333,\"#9c179e\"],[0.4444444444444444,\"#bd3786\"],[0.5555555555555556,\"#d8576b\"],[0.6666666666666666,\"#ed7953\"],[0.7777777777777778,\"#fb9f3a\"],[0.8888888888888888,\"#fdca26\"],[1.0,\"#f0f921\"]]}],\"heatmap\":[{\"type\":\"heatmap\",\"colorbar\":{\"outlinewidth\":0,\"ticks\":\"\"},\"colorscale\":[[0.0,\"#0d0887\"],[0.1111111111111111,\"#46039f\"],[0.2222222222222222,\"#7201a8\"],[0.3333333333333333,\"#9c179e\"],[0.4444444444444444,\"#bd3786\"],[0.5555555555555556,\"#d8576b\"],[0.6666666666666666,\"#ed7953\"],[0.7777777777777778,\"#fb9f3a\"],[0.8888888888888888,\"#fdca26\"],[1.0,\"#f0f921\"]]}],\"heatmapgl\":[{\"type\":\"heatmapgl\",\"colorbar\":{\"outlinewidth\":0,\"ticks\":\"\"},\"colorscale\":[[0.0,\"#0d0887\"],[0.1111111111111111,\"#46039f\"],[0.2222222222222222,\"#7201a8\"],[0.3333333333333333,\"#9c179e\"],[0.4444444444444444,\"#bd3786\"],[0.5555555555555556,\"#d8576b\"],[0.6666666666666666,\"#ed7953\"],[0.7777777777777778,\"#fb9f3a\"],[0.8888888888888888,\"#fdca26\"],[1.0,\"#f0f921\"]]}],\"contourcarpet\":[{\"type\":\"contourcarpet\",\"colorbar\":{\"outlinewidth\":0,\"ticks\":\"\"}}],\"contour\":[{\"type\":\"contour\",\"colorbar\":{\"o