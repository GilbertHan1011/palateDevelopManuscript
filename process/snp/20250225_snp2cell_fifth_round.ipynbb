   "source": [
    "import plotly.graph_objects as go\n",
    "import numpy as np\n",
    "import networkx as nx\n",
    "from ipywidgets import Button, HBox, VBox\n",
    "from plotly.subplots import make_subplots\n",
    "\n",
    "# Get Kamada-Kawai layout positions\n",
    "pos = nx.kamada_kawai_layout(G)\n",
    "\n",
    "# Create a function to plot the graph\n",
    "def create_network_plot(graph, positions, title=\"Network Graph\"):\n",
    "    # Create edge traces\n",
    "    edge_x = []\n",
    "    edge_y = []\n",
    "    for edge in graph.edges():\n",
    "        x0, y0 = positions[edge[0]]\n",
    "        x1, y1 = positions[edge[1]]\n",
    "        edge_x.extend([x0, x1, None])\n",
    "        edge_y.extend([y0, y1, None])\n",
    "\n",
    "    edge_trace = go.Scatter(\n",
    "        x=edge_x, y=edge_y,\n",
    "        line=dict(width=0.5, color='#888'),\n",
    "        hoverinfo='none',\n",
    "        mode='lines'\n",
    "    )\n",
    "\n",
    "    # Create node traces\n",
    "    node_x = []\n",
    "    node_y = []\n",
    "    node_text = []\n",
    "    for node in graph.nodes():\n",
    "        x, y = positions[node]\n",
    "        node_x.append(x)\n",
    "        node_y.append(y)\n",
    "        node_text.append(str(node))\n",
    "\n",
    "    node_trace = go.Scatter(\n",
    "        x=node_x, y=node_y,  # Fixed: was using edge_y incorrectly\n",
    "        mode='markers+text',\n",
    "        hoverinfo='text',\n",
    "        text=node_text,\n",
    "        textposition=\"top center\",\n",
    "        marker=dict(\n",
    "            size=10,\n",
    "            color='#1f77b4',\n",
    "        ),\n",
    "        textfont=dict(\n",
    "            size=8\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # Create figure\n",
    "    fig = go.FigureWidget(data=[edge_trace, node_trace],\n",
    "                  layout=go.Layout(\n",
    "                      title=title,\n",
    "                      showlegend=False,\n",
    "                      hovermode='closest',\n",
    "                      margin=dict(b=20,l=5,r=5,t=40),\n",
    "                      xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
    "                      yaxis=dict(showgrid=False, zeroline=False, showticklabels=False),\n",
    "                      dragmode='select'  # Enable box selection\n",
    "                  ))\n",
    "    \n",
    "    return fig\n",
    "\n",
    "# Create the main figure widget\n",
    "fig = create_network_plot(G, pos)\n",
    "\n",
    "# Create a button to extract the selected subnetwork\n",
    "extract_button = Button(description=\"Extract Selection\")\n",
    "reset_button = Button(description=\"Reset\")\n",
    "\n",
    "# Track selected nodes\n",
    "selected_nodes = []\n",
    "\n",
    "# Function to handle selection events\n",
    "def handle_selection(trace, points, selector):\n",
    "    global selected_nodes\n",
    "    selected_nodes = []\n",
    "    \n",
    "    if points.point_inds:\n",
    "        for idx in points.point_inds:\n",
    "            node_name = list(G.nodes())[idx]\n",
    "            selected_nodes.append(node_name)\n",
    "        \n",
    "        # Highlight selected nodes\n",
    "        new_colors = ['#ff0000' if i in points.point_inds else '#1f77b4' \n",
    "                     for i in range(len(list(G.nodes())))]\n",
    "        fig.data[1].marker.color = new_colors\n",
    "\n",
    "# Function to extract subnetwork on button click\n",
    "def extract_subnetwork(b):\n",
    "    global selected_nodes\n",
    "    if not selected_nodes:\n",
    "        print(\"No nodes selected. Please select nodes first.\")\n",
    "        return\n",
    "    \n",
    "    # Create subgraph from selected nodes\n",
    "    subgraph = G.subgraph(selected_nodes).copy()\n",
    "    \n",
    "    if len(subgraph.nodes()) == 0:\n",
    "        print(\"Selected region contains no nodes.\")\n",
    "        return\n",
    "    \n",
    "    # Create new positions dictionary containing only selected nodes\n",
    "    subgraph_pos = {node: pos[node] for node in subgraph.nodes()}\n",
    "    \n",
    "    # Create new plot\n",
    "    subfig = create_network_plot(subgraph, subgraph_pos, \"Subnetwork\")\n",
    "    \n",
    "    # Display the new figure\n",
    "    display(subfig)\n",
    "    \n",
    "    # Optionally save to HTML\n",
    "    subfig.write_html(\"../result/SNP/20250213_snp2cell_round1/subnetwork_graph.html\")\n",
    "\n",
    "# Reset function\n",
    "def reset_view(b):\n",
    "    fig.data[1].marker.color = '#1f77b4'\n",
    "    global selected_nodes\n",
    "    selected_nodes = []\n",
    "\n",
    "# Connect callbacks\n",
    "fig.data[1].on_selection(handle_selection)\n",
    "extract_button.on_click(extract_subnetwork)\n",
    "reset_button.on_click(reset_view)\n",
    "\n",
    "# Create widget layout\n",
    "control_panel = HBox([extract_button, reset_button])\n",
    "app = VBox([fig, control_panel])\n",
    "\n",
    "# Display the app\n",
    "display(app)\n",
    "\n",
    "# Still keep the original save functionality\n",
    "fig.write_html(\"../result/SNP/20250213_snp2cell_round1/20250225_network_graph_full.html\")"
   ]
  },
